{
  "name": "dsh-leng-team",
  "version": "2026.9.29",
  "release": "V2026092903",
  "description": "dsh-leng-team V9.3 专家团队插件：总指挥 + 14 核心角色 + 21 条件角色，任务类型识别、调查员与充分性门禁、条件启用三方会签、设计闭环、全局 5 并发席位池（1-5 可配）、令牌桶/429 状态机、4 分钟语义看门狗、全局回退预算、独立复验、可量化验收、事务快照、专家设置页。由 /team 或 /dsh-leng-team 触发。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js"
    },
    "./client": "./client/client.js"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "check:dual": "node scripts/check-dual-sync.mjs",
    "sync-web": "node scripts/sync-web.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-tool-subagent": "*",
    "@deepseek-ai/dsh-tool-workflow": "*"
  },
  "engines": {
    "node": ">=18"
  }
}
